# Dedicated staging host only. Copy locally to .env; never commit credentials.
CAPTURE_DOMAIN=capture-stage.example.com
CAPTURE_TOKEN=REPLACE_WITH_32_RANDOM_BYTES_HEX
CAPTURE_MIN_FREE_BYTES=2147483648
SMILE_CAPTURE_STORAGE_ENDPOINT=https://sgp1.digitaloceanspaces.com
SMILE_CAPTURE_STORAGE_REGION=sgp1
SMILE_CAPTURE_STORAGE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
SMILE_CAPTURE_STORAGE_ACCESS_KEY_ID=SET_OUTSIDE_GIT
SMILE_CAPTURE_STORAGE_SECRET_ACCESS_KEY=SET_OUTSIDE_GIT
SMILE_CAPTURE_STORAGE_PREFIX=staging/capture
SMILE_CAPTURE_MIRROR_INTERVAL_MS=15000
